{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["API_SERVER_BASE_URL", "APP_BASE_URL"]
    },
    "check-types": { "dependsOn": ["^check-types"] },
    "test": {},
    "dev": { "cache": false, "persistent": true }
  }
}
